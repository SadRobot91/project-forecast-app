# Database
DATABASE_URL=postgresql://localhost:5432/project_forecast
# Max connessioni del pool pg per istanza. In serverless (Vercel) tenere 1-3
# e puntare DATABASE_URL al connection pooler (PgBouncer/Supavisor, porta 6543).
PG_POOL_MAX=10

# CORS: origin ammessi, separati da virgola. Default: http://localhost:5173
# In produzione: CORS_ORIGIN=https://<app>.vercel.app
CORS_ORIGIN=

# ── Keyedin Integration ──────────────────────────────────────────────────────
# Base URL for the Keyedin Core API (admin + forecast data)
KEYEDIN_CORE_URL=https://coreapi.keyedinprojects.com

# Base URL for the Keyedin Reporting API (actuals)
KEYEDIN_REPORT_URL=https://coreapi.keyedinprojects.com

# API Key — from Keyedin > Integrations > API Keys
KEYEDIN_API_KEY=

# Numeric key of the "Project Actuals" report configured in Keyedin
# GET /v7.0/Report returns all available reports; find the one with actual hours/cost
KEYEDIN_REPORT_KEY=

# Numeric key of the project's current baseline forecast (Core API)
# Used to derive working_days_remaining from future expenditure lines
# GET /v7.0/Planning/Forecast?key=<k> to verify
KEYEDIN_FORECAST_KEY=

# Column names in the actuals report (exact string match, case-sensitive)
KEYEDIN_FIELD_HOURS=ActualHours
KEYEDIN_FIELD_COST=ActualCost
# Optional: if the report includes a "remaining days" column, set it here
# If empty, remaining days are derived from Core API expenditure or our Baseline
KEYEDIN_FIELD_REMAINING=
# Optional: date column in the report (e.g. "ReportDate", "AsOfDate")
# If set and the value parses as a valid date, it becomes the snapshot's reporting_date
# If empty or missing from the row, falls back to today()
KEYEDIN_FIELD_DATE=

# Filter parameter key used to pass the Keyedin project code in the report request
KEYEDIN_PARAM_PROJECT=param1

# Working hours per day (used to convert hours → working days)
KEYEDIN_HOURS_PER_DAY=8

ANTHROPIC_API_KEY=                      # Optional: enables KG intelligence features
EMBEDDING_API_KEY=                      # Optional: enables semantic similarity search
